#!/bin/sh
### BEGIN INIT INFO
# Provides:          datadog-agent
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Datadog IoT Agent
### END INIT INFO

DAEMON=/opt/datadog-agent/bin/agent/agent
PIDFILE=/opt/datadog-agent/run/agent.pid
USER=dd-agent
NAME=datadog-agent

case "$1" in
    start)
        echo "Starting $NAME..."
        mkdir -p /opt/datadog-agent/run /var/log/datadog
        chown -R ${USER}:${USER} /opt/datadog-agent/run /var/log/datadog
        start-stop-daemon --start --background --chuid ${USER} \
            --exec "$DAEMON" -- run -p "$PIDFILE"
        ;;
    stop)
        echo "Stopping $NAME..."
        start-stop-daemon --stop --pidfile "$PIDFILE" --retry=TERM/15/KILL/5
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "$NAME is running (pid $(cat "$PIDFILE"))"
            exit 0
        else
            echo "$NAME is not running"
            exit 3
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
